From a02fb62fbb1b61125ab9de54ad632530edbd3da7 Mon Sep 17 00:00:00 2001
From: mgianett <Mateus.GianettideJesus@windriver.com>
Date: Thu, 30 Apr 2026 11:12:42 -0300
Subject: [PATCH] Add-label-platform-application-to-istiod-pod

Signed-off-by: mgianett <Mateus.GianettideJesus@windriver.com>
---
 templates/deployment.yaml | 2 ++
 values.yaml               | 2 +
 2 files changed, 4 insertions(+)

diff --git a/templates/deployment.yaml b/templates/deployment.yaml
index 94e3e4e..928fb5f 100644
--- a/templates/deployment.yaml
+++ b/templates/deployment.yaml
@@ -59,10 +59,12 @@ spec:
         istio.io/dataplane-mode: none
         app.kubernetes.io/name: "istiod"
         {{- include "istio.labels" . | nindent 8 }}
+        app.starlingx.io/component: {{ ternary "application" "platform" (eq .Values.component "application") }}
       annotations:
         prometheus.io/port: "15014"
         prometheus.io/scrape: "true"
         sidecar.istio.io/inject: "false"
+        configchecksum: {{ .Values.component | quote | sha256sum }}
         {{- if .Values.podAnnotations }}
 {{ toYaml .Values.podAnnotations | indent 8 }}
         {{- end }}
diff --git a/values.yaml b/values.yaml
index 41dff2d..7bc5eab 100644
--- a/values.yaml
+++ b/values.yaml
@@ -586,3 +586,5 @@ _internal_defaults_do_not_set:
     # -- Eviction policy for unhealthy pods guarded by PodDisruptionBudget.
     # Ref: https://kubernetes.io/blog/2023/01/06/unhealthy-pod-eviction-policy-for-pdbs/
     unhealthyPodEvictionPolicy: ""
+  # StarlingX App Label
+  component: platform
-- 
2.43.0

